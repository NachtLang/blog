{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node node_modules/hexo-cli/bin/hexo generate",
  "devCommand": "node node_modules/hexo-cli/bin/hexo server",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/zato", "destination": "/zato/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/zato/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zato/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zato/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zato/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zato/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
