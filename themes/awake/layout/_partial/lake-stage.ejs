<div class="lake-stage" data-lake-stage>
  <canvas class="lake-stage__canvas" data-lake-canvas aria-hidden="true"></canvas>
  <video class="lake-stage__video" data-lake-video muted loop playsinline preload="metadata" aria-hidden="true">
    <source src="<%= url_for('/media/lake-surface.mp4') %>" type="video/mp4">
    <source src="<%= url_for('/media/lake-surface.webm') %>" type="video/webm">
  </video>
</div>
