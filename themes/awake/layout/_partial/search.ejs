<div class="search" data-search hidden>
  <div class="search__backdrop" data-search-close></div>
  <div class="search__panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search__head">
      <span class="search__eyebrow">SEARCH / 文章</span>
      <button class="search__close" type="button" data-search-close aria-label="关闭搜索">×</button>
    </div>
    <div class="search__field">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="5.6" stroke="currentColor" stroke-width="1.3"/>
        <path d="M13.4 13.4 17 17" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      <input class="search__input" id="search-input" type="search" placeholder="搜索文章…" autocomplete="off" spellcheck="false" data-search-input aria-label="搜索文章">
      <kbd class="search__kbd">ESC</kbd>
    </div>
    <div class="search__results" data-search-results>
      <div class="search__empty">
        <span class="search__empty-mark" aria-hidden="true"></span>
        <p class="search__empty-title">输入关键词</p>
        <p class="search__empty-note">从文章标题、摘要和标签中查找。</p>
      </div>
    </div>
  </div>
</div>
