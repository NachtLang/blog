<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="brand" href="<%= url_for('/') %>" aria-label="<%= theme.site_name %> 首页">
      <span class="brand__name"><%= theme.site_name %></span>
    </a>

    <nav class="nav__links" aria-label="主导航">
      <% (theme.nav || []).forEach(function (item) { %>
        <a class="nav__link<%= awake_nav_active(item.id) ? ' is-active' : '' %>" href="<%= url_for(item.url) %>">
          <span><%= item.title %></span>
        </a>
      <% }); %>
    </nav>

    <div class="nav__actions">
      <button class="search-trigger" type="button" data-search-open aria-label="打开搜索">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="5.6" stroke="currentColor" stroke-width="1.3"/>
          <path d="M13.4 13.4 17 17" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <span class="search-trigger__text">搜索</span>
        <kbd class="search-trigger__kbd">⌘K</kbd>
      </button>
      <button class="menu-toggle" type="button" data-menu-open aria-label="打开菜单" aria-expanded="false" aria-controls="site-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
