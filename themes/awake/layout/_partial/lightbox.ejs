<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="照片预览" aria-hidden="true">
  <img class="lightbox__img" data-lightbox-img alt="">
  <p class="lightbox__cap" data-lightbox-cap></p>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="关闭">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="上一张">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 5 7 10l5.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="下一张">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 5 13 10l-5.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>
