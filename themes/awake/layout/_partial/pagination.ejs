<%
  if (!page.total || page.total <= 1) { return; }
  var base = page.base || '/';
  var current = page.current || 1;
  var total = page.total || 1;
%>
<nav class="pagination" aria-label="分页">
  <% if (page.prev_link) { %>
    <a class="pagination__link" href="<%= url_for(page.prev_link) %>">← 上一页</a>
  <% } else { %>
    <span class="pagination__link is-disabled">← 上一页</span>
  <% } %>
  <span class="pagination__count"><%= current %> / <%= total %></span>
  <% if (page.next_link) { %>
    <a class="pagination__link" href="<%= url_for(page.next_link) %>">下一页 →</a>
  <% } else { %>
    <span class="pagination__link is-disabled">下一页 →</span>
  <% } %>
</nav>
